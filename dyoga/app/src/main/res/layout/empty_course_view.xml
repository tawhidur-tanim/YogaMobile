<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingVertical="@dimen/screen_padding_vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    tools:context=".activities.DashboardActivity"
    tools:ignore="ExtraText">

    android:paddingVertical="@dimen/screen_padding_vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    tools:context=".activities.EmptyClassActivity"
    tools:ignore="ExtraText">

    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You have no courses"
        android:textSize="12sp"
        app:drawableTopCompat="@android:drawable/ic_dialog_info"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/headerSection" />


</androidx.constraintlayout.widget.ConstraintLayout>