<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="@dimen/screen_padding_vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    tools:context=".activities.DashboardActivity">

    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/ScreenHeading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="@string/dashTitle" />

        <ImageButton
            android:id="@+id/addCourseButton"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:layout_gravity="center"
            android:src="@drawable/plus_solid"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/logoutButton"
            android:padding="10dp"
            android:layout_marginStart="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:layout_gravity="center"
            android:src="@drawable/log_out_icon"
            android:contentDescription="@string/logout"
            android:importantForAccessibility="no" />

    </LinearLayout>

    <include
        android:id="@+id/emptyCourseView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        layout="@layout/empty_course_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerSection"/>

    <LinearLayout
        android:id="@+id/dashSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerSection">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="@dimen/edittext_height"
            android:background="@drawable/edittext_background"
            android:hint="@string/searchHintCourse"
            android:padding="15dp"
            android:textSize="12sp"
            android:id="@+id/searchCourse"
            />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/recycler_view_vertical_padding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashSearch"
        tools:listitem="@layout/course_layout"
        android:id="@+id/courseListRecyclerView"
        />

</androidx.constraintlayout.widget.ConstraintLayout>