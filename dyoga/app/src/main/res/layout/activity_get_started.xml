<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@raw/splash_1"
    tools:context=".activities.GetStartedActivity">


    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="355dp"
        android:layout_height="267dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@raw/dyoga" />


    <Button
        android:id="@+id/button"
        android:layout_width="276dp"
        android:layout_height="56dp"
        android:text="@string/continue_with_google"
        android:textSize="16sp"
        android:layout_marginBottom="40dp"
        app:backgroundTint="@color/colorSecondary"
        app:layout_constraintEnd_toEndOf="@+id/imageView3"
        app:layout_constraintStart_toStartOf="@+id/imageView3"
        app:layout_constraintBottom_toTopOf="@id/btnCopyRight" />

    <TextView
        android:id="@+id/btnCopyRight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/copyright_2023"
        android:layout_marginBottom="8dp"
        android:textColor="#82000000"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@+id/button"
        app:layout_constraintStart_toStartOf="@+id/button"
        app:layout_constraintBottom_toTopOf="@id/productOfGroupii" />


    <TextView
        android:id="@+id/productOfGroupii"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/product_of_group_ii"
        android:layout_marginBottom="30dp"
        android:layout_marginTop="8dp"
        android:textColor="#8200000F"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>