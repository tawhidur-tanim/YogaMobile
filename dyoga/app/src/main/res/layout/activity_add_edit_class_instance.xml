<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.AddCourseActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingVertical="@dimen/screen_padding_vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="@style/ScreenHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingRight="20dp"
                android:id="@+id/clasScreenHeading"
                android:text="Add a class" />

          <ImageButton
              android:padding="12dp"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:background="@color/transparent"
              android:layout_gravity="center"
              android:visibility="gone"
              android:id="@+id/deleteButton"
              android:src="@drawable/trash_icon"/>

        </LinearLayout>


        <TextView
            style="@style/ScreenParagraph"
            android:id="@+id/screenDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add a new class instance to family yoga by 11:00am" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="42dp" />


        <TextView
            style="@style/ScreenParagraphTwo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date" />

        <Button
            style="@style/Theme.Dyoga.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edittext_height"
            android:id="@+id/dateButton"
            android:background="@drawable/edittext_background"
            android:backgroundTint="@color/buttonBackground"
            android:gravity="start|center"
            android:textSize="@dimen/text_default_size"
            android:text="@string/date_format"
            android:textColor="@color/grey"
            app:background="@drawable/edittext_background"
            app:backgroundTint="@color/buttonBackground" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:layout_weight=".5"
                android:orientation="vertical">
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="42dp" />

                <TextView
                    android:id="@+id/price_label"
                    style="@style/ScreenParagraphTwo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instructor" />

                <EditText
                    style="@style/Theme.Dyoga.EditText"
                    android:id="@+id/classInstructorEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edittext_height"
                    android:importantForAutofill="no"
                    android:labelFor="@+id/classInstanceInstructorLabel_label" />
            </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight=".5"
                android:orientation="vertical">
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="42dp" />

                <TextView
                    android:id="@+id/roomLabel"
                    style="@style/ScreenParagraphTwo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room" />

                <EditText
                    style="@style/Theme.Dyoga.EditText"
                    android:id="@+id/roomEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edittext_height"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:labelFor="@+id/roomLabel" />
            </LinearLayout>


        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="42dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/classDescriptionDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical">

            <TextView
                android:id="@+id/classDescriptionLabel"
                style="@style/ScreenParagraphTwo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/description" />

            <EditText
                style="@style/Theme.Dyoga.EditText"
                android:id="@+id/classDescriptionEditText"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:layout_gravity="start"
                android:gravity="start"
                android:labelFor="@+id/descriptionLabel" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/circle_plus_solid"
                android:id="@+id/classAddDescriptionImageView"
                android:contentDescription="@string/add_a_description" />

            <TextView
                android:id="@+id/classAddDescriptionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:text="Add a comment" />
        </LinearLayout>
    </LinearLayout>



        <Space
            android:layout_width="match_parent"
            android:layout_height="42dp" />


        <Button
            android:id="@+id/saveClassButton"
            android:layout_width="270dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:backgroundTint="@color/colorSecondary"
            android:text="Save"
            app:backgroundTint="@color/colorSecondary" />
    </LinearLayout>
</ScrollView>