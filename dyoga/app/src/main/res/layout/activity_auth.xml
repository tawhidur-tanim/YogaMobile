<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:paddingVertical="@dimen/screen_padding_vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    tools:context=".activities.AuthActivity">

    <TextView
        style="@style/ScreenHeading"
        android:id="@+id/screenHeading"
        android:layout_width="235dp"
        android:layout_height="42dp"
        android:text="@string/register_login"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        style="@style/ScreenParagraph"
        android:id="@+id/screenInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/new_or_have_an_account_nenter_your_email_and_a_password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/screenHeading" />

    <TextView
        style="@style/ScreenParagraphTwo"
        android:id="@+id/emailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/screenInfo"/>

    <EditText
        style="@style/Theme.Dyoga.EditText"
        android:id="@+id/emailEditText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/edittext_height"
        android:layout_marginTop="4dp"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:focusedByDefault="true"
        android:labelFor="@+id/emailLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emailLabel" />

    <TextView
        style="@style/ScreenParagraphTwo"
        android:id="@+id/passwordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_vertical_spacing_two"
        android:text="@string/passcode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emailEditText"/>

    <EditText
        style="@style/Theme.Dyoga.EditText"
        android:id="@+id/passwordEditText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/edittext_height"
        android:layout_marginTop="4dp"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:labelFor="@+id/passwordLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordLabel" />

    <Button
        android:id="@+id/continueButton"
        android:layout_width="270dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:backgroundTint="@color/colorSecondary"
        android:text="@string/continue_text"
        app:backgroundTint="@color/colorSecondary"
        app:layout_constraintTop_toBottomOf="@id/passwordEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/loadingProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/continueButton"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/btnCopyRight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/copyright_2023"
        android:layout_marginBottom="8dp"
        android:textColor="#82000000"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@+id/getStarted"
        app:layout_constraintStart_toStartOf="@+id/getStarted"
        app:layout_constraintBottom_toTopOf="@id/productOfGroupii" />

    <TextView
        android:id="@+id/productOfGroupii"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/product_of_group_ii"
        android:layout_marginTop="8dp"
        android:textColor="#8200000F"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
