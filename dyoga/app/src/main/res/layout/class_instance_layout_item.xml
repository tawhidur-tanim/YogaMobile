<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="15dp"
    android:layout_marginBottom="@dimen/recycler_view_item_bottom_margin"
    android:background="@drawable/rc_blue_background">

    <TextView
        style="@style/ScreenHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/october_24th_2023"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:id="@+id/classInstanceDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/instructor"
        android:textColor="@color/white"
        android:layout_marginTop="10dp"
        android:id="@+id/classInstanceInstructorLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/classInstanceDate" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/john_doe"
        android:textColor="@color/white"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="5dp"
        android:id="@+id/classInstanceInstructor"
        app:layout_constraintStart_toEndOf="@id/classInstanceInstructorLabel"
        app:layout_constraintTop_toBottomOf="@id/classInstanceDate" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/room"
        android:textColor="@color/white"
        android:id="@+id/classInstanceRoomLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/classInstanceInstructor" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/queen_anne_404"
        android:textColor="@color/white"
        android:layout_marginHorizontal="5dp"
        android:id="@+id/classInstanceRoom"
        app:layout_constraintStart_toEndOf="@id/classInstanceRoomLabel"
        app:layout_constraintTop_toBottomOf="@id/classInstanceInstructor"
        />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/clock_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:flow_horizontalAlign="center"
        app:flow_verticalAlign="center"
        />
</androidx.constraintlayout.widget.ConstraintLayout>